APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:Vikas%401983@localhost:5432/zysmart

# Meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0

# client_api (M3/M4 inbox + assignments + WS)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLIENT_API_JWT_SECRET=dev-insecure-change-me
CLIENT_API_JWT_TTL_MINUTES=720
CLIENT_API_EVENT_POLL_MS=500
CLIENT_API_CORS_ORIGINS=*

# ops_api (M9 — SOP / Runbook on port 8087 by convention; JWT = same CLIENT_API_JWT_SECRET as client_api)
OPS_API_CORS_ORIGINS=*

# billing_api (M5 — Razorpay + Paddle webhooks on port 8086 by convention)
# Razorpay: Dashboard → Account & Settings → Webhooks → signing secret for your endpoint URL.
BILLING_RAZORPAY_WEBHOOK_SECRET=
# Paddle Billing: Developer tools → Notifications → destination signing secret (NOT the API key).
BILLING_PADDLE_WEBHOOK_SECRET=

# Chat K — usage_increment_worker + metrics_rollup_worker (optional; see HANDOFF.md)
# USAGE_WORKER_BATCH_SIZE=500
# USAGE_WORKER_SLEEP_SECONDS=2
# METRICS_ROLLUP_SLEEP_SECONDS=300
# METRICS_ROLLUP_LOOKBACK_DAYS=3
# METRICS_ROLLUP_HOURLY_LOOKBACK=48

