APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:Vikas%401983@localhost:5432/zysmart

# Meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0

# WA gateway (M2): dev routing bypass — requires explicit opt-in (even when APP_ENV=dev).
# Prefer wa_numbers + wa_trial_map; use only for synthetic tools when no DB mapping exists.
# WA_GATEWAY_ALLOW_CLIENT_ID_HEADER=true

# client_api (M3/M4 inbox + assignments + WS)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLIENT_API_JWT_SECRET=dev-insecure-change-me
CLIENT_API_JWT_TTL_MINUTES=720
CLIENT_API_EVENT_POLL_MS=500
CLIENT_API_CORS_ORIGINS=*
# Optional: comma-separated browser Origins for /ws (empty = do not enforce). Use WSS + short JWTs in prod.
CLIENT_API_WS_ALLOWED_ORIGINS=

# ops_api (M9 — SOP / Runbook on port 8087 by convention; JWT = same CLIENT_API_JWT_SECRET as client_api)
OPS_API_CORS_ORIGINS=*

# billing_api (M5 — Razorpay + Paddle webhooks on port 8086 by convention)
# Razorpay: Dashboard → Account & Settings → Webhooks → signing secret for your endpoint URL.
BILLING_RAZORPAY_WEBHOOK_SECRET=
# Paddle Billing: Developer tools → Notifications → destination signing secret (NOT the API key).
BILLING_PADDLE_WEBHOOK_SECRET=

# billing_api REST (checkout / subscription reads / KYC) — same HS256 secret as client_api for Bearer JWT
BILLING_RAZORPAY_KEY_ID=
BILLING_RAZORPAY_KEY_SECRET=
BILLING_PADDLE_API_KEY=
BILLING_PADDLE_ENVIRONMENT=sandbox
BILLING_PADDLE_API_VERSION=1
BILLING_API_CORS_ORIGINS=*

# Chat K — usage_increment_worker + metrics_rollup_worker (optional; see HANDOFF.md)
# USAGE_WORKER_BATCH_SIZE=500
# USAGE_WORKER_SLEEP_SECONDS=2
# METRICS_ROLLUP_SLEEP_SECONDS=300
# METRICS_ROLLUP_LOOKBACK_DAYS=3
# METRICS_ROLLUP_HOURLY_LOOKBACK=48

# Chat L — broadcast + alert workers (optional; requires 0010_m6_m7_broadcast_alerts)
# BROADCAST_WORKER_SLEEP_SECONDS=2
# BROADCAST_WORKER_BATCH_SIZE=50
# ALERT_EVAL_WORKER_SLEEP_SECONDS=120

# Optional pytest: Postgres integration for Chat K workers + ops schema sanity (see README *Optional Postgres integration*).
# RUN_POSTGRES_INTEGRATION=1

# ai_engine (M1): optional OpenAI-compatible LLM — requires ops_runtime_config ai.fallback.enabled=true to spend tokens.
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_API_KEY=
# AI_LLM_PRIMARY_MODEL=gpt-4o-mini
# AI_LLM_JUDGE_MODEL=gpt-4o-mini

